extends ../layout

block content

    .container.mt-4

        .row.justify-content-center

            .col-lg-6

                .card.border-0.shadow-sm

                    .card-header.bg-white.border-0.pt-4.pb-0

                        h4.mb-0
                            i.bi.bi-flag.text-danger.me-2
                            | Denunciar comentario

                        p.text-muted.small.mt-1 Esta denuncia será revisada por nuestro equipo de moderación.

                    .card-body.pt-3

                        .card.bg-light.border-0.rounded-3.mb-4

                            .card-body.py-2

                                p.text-muted.small.mb-1
                                    strong= comentario.Usuario.username
                                    |  dijo:

                                p.mb-0= comentario.contenido

                        if errores && errores.general
                            include ../../partials/alert
                            +alert({ status: 'error', text: errores.general })

                        form(action=`/denuncia/comentario/${comentario.id}` method="POST" novalida)

                            .mb-3
                                label.form-label.fw-semibold Motivo *
                                select.form-select(
                                    name="motivo"
                                    class= errores && errores.motivo ? 'is-invalid' : ''
                                )
                                    option(value="" disabled selected) Seleccioná un motivo
                                    option(value="contenido inapropiado") Contenido inapropiado
                                    option(value="spam") Spam o publicidad
                                    option(value="acoso") Acoso o intimidación
                                    option(value="lenguaje ofensivo") Lenguaje ofensivo
                                    option(value="desinformacion") Desinformación
                                    option(value="otro") Otro

                                if errores && errores.motivo
                                    .invalid-feedback #{errores.motivo}

                            .mb-4
                                label.form-label.fw-semibold Descripción *
                                textarea.form-control(
                                    name="descripcion"
                                    rows="4"
                                    placeholder="Describí el problema con este comentario..."
                                    class= errores && errores.descripcion ? 'is-invalid' : ''
                                )= formValues && formValues.descripcion
                                .form-text Mínimo 10 caracteres.
                                if errores && errores.descripcion
                                    .invalid-feedback #{errores.descripcion}

                            .d-flex.gap-2

                                button.btn.btn-danger(type="submit") Enviar denuncia

                                a.btn.btn-outline-secondary(
                                    href=`/usuario/publicaciones/${idPublicacion || publicacionId}`
                                ) Cancelar
