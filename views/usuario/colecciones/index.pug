extends ../layout

block content

    .container.mt-4

        .d-flex.justify-content-between.align-items-center.mb-4

            h4.mb-0
                i.bi.bi-collection.me-2
                | Mis colecciones

            button.btn.btn-success(
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#modalCrearColeccion"
            )
                i.bi.bi-plus.me-1
                | Nueva colección

        if !colecciones.length

            .text-center.py-5
                i.bi.bi-collection.fs-1.text-muted
                p.text-muted.mt-3 No tenés colecciones todavía.
                p.text-muted.small Guardá publicaciones que te gusten para encontrarlas fácilmente.

        else

            .row.g-3

                each col in colecciones

                    .col-6.col-md-4.col-lg-3

                        a.text-decoration-none(href=`/usuario/colecciones/${col.id}`)

                            .card.border-0.shadow-sm.h-100

                                if col.thumbnail
                                    img.card-img-top(
                                        src=col.thumbnail
                                        alt=col.nombre
                                        style="height:140px; object-fit:cover"
                                    )
                                else
                                    .d-flex.align-items-center.justify-content-center.bg-light(
                                        style="height:140px"
                                    )
                                        i.bi.bi-images.fs-2.text-muted

                                .card-body.py-2.px-3

                                    p.mb-0.fw-semibold.text-dark= col.nombre
                                    small.text-muted #{col.cantidadPublicaciones} publicaciones

    #modalCrearColeccion.modal.fade(tabindex="-1" aria-hidden="true")

        .modal-dialog.modal-dialog-centered

            .modal-content

                .modal-header.border-0

                    h5.modal-title Nueva colección

                    button.btn-close(type="button" data-bs-dismiss="modal")

                .modal-body

                    form(action="/usuario/colecciones/crear" method="POST")

                        .mb-3
                            label.form-label Nombre
                            input.form-control(
                                type="text"
                                name="nombre"
                                placeholder="Ej: Paisajes, Retratos, Ideas..."
                                maxlength="50"
                                required
                            )

                        .d-flex.gap-2.justify-content-end

                            button.btn.btn-outline-secondary(
                                type="button"
                                data-bs-dismiss="modal"
                            ) Cancelar

                            button.btn.btn-success(type="submit") Crear
