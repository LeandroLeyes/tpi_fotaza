extends ../layout

block content

    .container.mt-4

        h4.mb-4
            i.bi.bi-chat-dots.me-2
            | Mensajes

        if !chats.length

            .text-center.py-5
                i.bi.bi-chat-square.fs-1.text-muted
                p.text-muted.mt-3 No tenés conversaciones todavía.
                p.text-muted.small Cuando alguien marque "me interesa" en tus imágenes, el chat aparecerá acá.

        else

            .list-group.shadow-sm

                each chat in chats

                    a.list-group-item.list-group-item-action(href=`/usuario/chat/${chat.id}`)

                        .d-flex.align-items-center.gap-3

                            if chat.otroUsuario.avatar
                                img.rounded-circle(
                                    src=chat.otroUsuario.avatar
                                    width="50"
                                    height="50"
                                    style="object-fit:cover; flex-shrink:0"
                                )
                            else
                                .avatar-placeholder.rounded-circle.avatar-sm.flex-shrink-0= chat.otroUsuario.name[0].toUpperCase() + chat.otroUsuario.lastName[0].toUpperCase()

                            .flex-grow-1.overflow-hidden

                                .d-flex.justify-content-between.align-items-center

                                    strong= chat.otroUsuario.username

                                    small.text-muted= new Date(chat.updatedAt).toLocaleDateString('es-AR')

                                p.text-muted.small.mb-0.text-truncate
                                    if chat.ultimoMensaje
                                        = chat.ultimoMensaje.contenido
                                    else
                                        | Sin mensajes aún

                            if chat.thumbnailImagen
                                img.rounded(
                                    src=chat.thumbnailImagen
                                    width="45"
                                    height="45"
                                    style="object-fit:cover; flex-shrink:0"
                                )
