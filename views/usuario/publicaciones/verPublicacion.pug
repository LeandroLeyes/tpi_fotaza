extends ../layout

block content

    .container-fluid.mt-4

        .row.g-4

            .col-lg-8

                .card.shadow-sm.border-0

                    if publicacion.imagenes.length > 0

                        #carouselPublicacion.carousel.slide(data-bs-ride="false")

                            .carousel-inner

                                each imagen, index in publicacion.imagenes

                                    .carousel-item(class=index === 0 ? "active" : "")

                                        img.d-block.w-100.rounded(
                                            src=imagen.imagenBase64,
                                            alt=publicacion.titulo
                                        )

                            if publicacion.imagenes.length > 1

                                button.carousel-control-prev(
                                    type="button",
                                    data-bs-target="#carouselPublicacion",
                                    data-bs-slide="prev"
                                )
                                    span.carousel-control-prev-icon

                                button.carousel-control-next(
                                    type="button",
                                    data-bs-target="#carouselPublicacion",
                                    data-bs-slide="next"
                                )
                                    span.carousel-control-next-icon

                        if publicacion.imagenes.length > 1

                            .text-center.py-2.text-muted.small

                                span#indicadorImagen Imagen 1 de #{publicacion.imagenes.length}

            .col-lg-4

                .card.shadow-sm.border-0.h-100

                    .card-body

                        .d-flex.justify-content-between.align-items-start.mb-3

                            h2.card-title.mb-0= publicacion.titulo

                            .d-flex.gap-2.align-items-center

                                if !esPropietario
                                    button.btn.btn-light.btn-sm(
                                        type="button"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalGuardarColeccion"
                                        title="Guardar en colección"
                                    )
                                        i.bi.bi-bookmark

                                .dropdown

                                    button.btn.btn-light.btn-sm(
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                    ) ⋮

                                ul.dropdown-menu.dropdown-menu-end

                                    if esPropietario

                                        li

                                            form(
                                                action=`/usuario/publicaciones/${publicacion.id}/comentarios`
                                                method="POST"
                                            )

                                                if publicacion.comentariosActivo

                                                    button.dropdown-item(type="submit")
                                                        | Cerrar comentarios

                                                else

                                                    button.dropdown-item(type="submit")
                                                        | Abrir comentarios

                                        li

                                            a.dropdown-item(
                                                href=`/usuario/publicaciones/${publicacion.id}/editar`
                                            )
                                                | Editar publicación

                                        li
                                            hr.dropdown-divider

                                        li

                                            button.dropdown-item.text-danger(
                                                type="button"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEliminarPublicacion"
                                            )
                                                | Eliminar publicación

                                    else

                                        li

                                            a.dropdown-item(
                                                href=`/denuncia/publicacion/${publicacion.id}`
                                            )
                                                i.bi.bi-flag.me-2.text-danger
                                                | Denunciar publicación

                        p.text-muted.mb-3= publicacion.descripcion

                        if publicacion.Etiqueta && publicacion.Etiqueta.length

                            .publication-tags.mb-4

                                each etiqueta in publicacion.Etiqueta

                                    a.text-decoration-none.me-2(
                                        href=`/buscar?q=${etiqueta.nombre}`
                                    )
                                        | ##{etiqueta.nombre}

                        hr

                        a.text-decoration-none.text-dark(
                            href=`/usuario/perfil/${publicacion.Usuario.id}`
                        )

                            .d-flex.align-items-center.gap-3
                                if publicacion.Usuario.avatar
                                    img.rounded-circle.shadow-sm(
                                        src=publicacion.Usuario.avatar
                                        width="55"
                                        height="55"
                                        style="object-fit:cover"
                                    )
                                else    
                                    .avatar-placeholder.rounded-circle.shadow(style="width:55; height:55;")= publicacion.Usuario.name[0].toUpperCase()+publicacion.Usuario.lastName[0].toUpperCase()

                                div

                                    h6.mb-0= publicacion.Usuario.username

                                    small.text-muted Ver perfil

                        hr

                        each imagen, index in publicacion.imagenes

                            .imagen-panel(
                                id=`panel-imagen-${index}`,
                                style=index === 0 ? "" : "display:none"
                            )

                                if !esPropietario

                                    h5.mb-3 Valoración

                                    form(
                                        action=`/usuario/valoraciones/${imagen.id}`
                                        method="POST"
                                        novalidate
                                    )

                                        input(
                                            type="hidden"
                                            name="idPublicacion"
                                            value=publicacion.id
                                        )

                                        .rating-container.mb-3

                                            - for (let i = 1; i <= 5; i++)
                                                button.btn.btn-link.p-0.fs-3.star-btn(
                                                    type="submit"
                                                    name="puntaje"
                                                    value=`${i}`
                                                    class=imagen.Valoracions && imagen.Valoracions.find(v => v.idUsuario === miUsuarioId && v.puntaje === i) ? 'star-active' : ''
                                                ) ★

                                    form(
                                        action=`/usuario/chat/interes/${imagen.id}`
                                        method="POST"
                                    )
                                        button.btn.btn-outline-success.w-100.mb-3(type="submit")
                                            i.bi.bi-heart.me-2
                                            | Me interesa

                                    hr

                                h5.mb-3 Estadísticas

                                .d-flex.gap-3.mb-4

                                    - const total = imagen.Valoracions ? imagen.Valoracions.length : 0
                                    - const promedio = total > 0 ? (imagen.Valoracions.reduce((s, v) => s + v.puntaje, 0) / total) : 0

                                    span.small
                                        span.text-success.fw-semibold= promedio.toFixed(1)
                                        span.text-muted  ★ 

                                    span.small
                                        span.text-success.fw-semibold= total
                                        span.text-muted 
                                            i.bi.bi-people-fill.me-1

                                hr

                                h5.mb-2 Comentarios

                                if publicacion.comentariosActivo

                                    form.mb-3(
                                        action=`/usuario/comentarios/${imagen.id}`
                                        method="POST"
                                        novalidate
                                    )

                                        input(
                                            type="hidden"
                                            name="idPublicacion"
                                            value=publicacion.id
                                        )

                                        textarea.form-control.mb-2(
                                            name="contenido"
                                            rows="3"
                                            placeholder="Escribí un comentario..."
                                        )

                                        button.btn.btn-success(type="submit") Comentar

                                else

                                    .alert.alert-secondary.mb-3
                                        | Los comentarios fueron cerrados por el autor.

                                if imagen.Comentarios && imagen.Comentarios.length

                                    button.btn.btn-outline-success.w-100.mb-3(
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target=`#comentarios-${index}`
                                        aria-expanded="true"
                                    )
                                        | Comentarios (#{imagen.Comentarios.length})

                                    .collapse.show(id=`comentarios-${index}`)

                                        .comment-container

                                            each comentario in imagen.Comentarios

                                                .card.bg-light.border-0.mb-3

                                                    .card-body

                                                        .d-flex.align-items-center.justify-content-between.mb-2

                                                            .d-flex.align-items-center.gap-2
                                                                if comentario.Usuario.avatar
                                                                    img.rounded-circle(
                                                                        src=comentario.Usuario.avatar
                                                                        width="35"
                                                                        height="35"
                                                                        style="object-fit:cover"
                                                                    )
                                                                else
                                                                    .avatar-placeholder.rounded-circle.shadow.avatar-sm= comentario.Usuario.name[0].toUpperCase() + comentario.Usuario.lastName[0].toUpperCase()

                                                                strong= comentario.Usuario.username

                                                            .d-flex.gap-1

                                                                if comentario.idUsuario === miUsuarioId

                                                                    form(
                                                                        action=`/usuario/comentarios/${comentario.id}/eliminar`
                                                                        method="POST"
                                                                    )
                                                                        button.btn.btn-link.text-danger.p-0(
                                                                            type="submit"
                                                                            title="Eliminar comentario"
                                                                        )
                                                                            i.bi.bi-trash3.small

                                                                else

                                                                    a.btn.btn-link.text-muted.p-0(
                                                                        href=`/denuncia/comentario/${comentario.id}`
                                                                        title="Denunciar comentario"
                                                                    )
                                                                        i.bi.bi-flag.small

                                                        p.mb-0= comentario.contenido

                                else

                                    p.text-muted.small No hay comentarios en esta imagen.

    if esPropietario

        #modalEliminarPublicacion.modal.fade(
            tabindex="-1"
            aria-labelledby="modalEliminarLabel"
            aria-hidden="true"
        )

            .modal-dialog.modal-dialog-centered

                .modal-content

                    .modal-header.border-0

                        h5.modal-title#modalEliminarLabel Eliminar publicación

                        button.btn-close(
                            type="button"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"
                        )

                    .modal-body

                        p ¿Estas seguro que queres eliminar 
                            strong= publicacion.titulo
                            | ?

                        p.text-muted.small Esta accion no se puede deshacer. Se eliminaran todas las imagenes, comentarios y valoraciones asociadas.

                    .modal-footer.border-0

                        button.btn.btn-secondary(
                            type="button"
                            data-bs-dismiss="modal"
                        ) Cancelar

                        form(
                            action=`/usuario/publicaciones/${publicacion.id}/eliminar`
                            method="POST"
                        )

                            button.btn.btn-danger(type="submit") Si, eliminar

    //- Modal guardar en colección
    if !esPropietario

        #modalGuardarColeccion.modal.fade(tabindex="-1" aria-hidden="true")

            .modal-dialog.modal-dialog-centered

                .modal-content

                    .modal-header.border-0

                        h5.modal-title
                            i.bi.bi-bookmark.me-2
                            | Guardar en colección

                        button.btn-close(type="button" data-bs-dismiss="modal")

                    .modal-body

                        #coleccionesLista.d-flex.flex-column.gap-2

                            p.text-muted.text-center.small Cargando colecciones...

                    .modal-footer.border-0.flex-column.align-items-stretch.gap-2

                        hr.mt-0

                        p.text-muted.small.mb-1 O creá una nueva colección:

                        .d-flex.gap-2

                            form.d-flex.gap-2.w-100(
                                action="/usuario/colecciones/crear"
                                method="POST"
                            )
                                input.form-control.form-control-sm(
                                    type="text"
                                    name="nombre"
                                    placeholder="Nombre de la colección"
                                    maxlength="50"
                                    required
                                )
                                button.btn.btn-sm.btn-success(type="submit") Crear

    script.

        const modalGuardar = document.getElementById('modalGuardarColeccion');
        if (modalGuardar) {
            modalGuardar.addEventListener('show.bs.modal', async () => {
                const lista = document.getElementById('coleccionesLista');
                try {
                    const res = await fetch('/usuario/colecciones/api');
                    const colecciones = await res.json();
                    if (colecciones.length === 0) {
                        lista.innerHTML = '<p class="text-muted text-center small">No tenés colecciones. Creá una abajo.</p>';
                    } else {
                        lista.innerHTML = colecciones.map(c => `
                            <form action="/usuario/publicaciones/${publicacion.id}/guardar" method="POST" class="d-grid">
                                <input type="hidden" name="idColeccion" value="${c.id}">
                                <button type="submit" class="btn btn-outline-secondary btn-sm text-start">
                                    <i class="bi bi-collection me-2"></i>${c.nombre}
                                </button>
                            </form>
                        `).join('');
                    }
                } catch(e) {
                    lista.innerHTML = '<p class="text-danger small">Error al cargar colecciones.</p>';
                }
            });
        }

    script.

        const carousel = document.getElementById('carouselPublicacion');
        const indicador = document.getElementById('indicadorImagen');
        const totalImagenes = #{publicacion.imagenes.length};

        if (carousel) {
            carousel.addEventListener('slide.bs.carousel', function (e) {
                const siguiente = e.to;

                document.querySelectorAll('.imagen-panel').forEach(function(panel) {
                    panel.style.display = 'none';
                });

                const panelActivo = document.getElementById('panel-imagen-' + siguiente);
                if (panelActivo) panelActivo.style.display = '';

                if (indicador) {
                    indicador.textContent = 'Imagen ' + (siguiente + 1) + ' de ' + totalImagenes;
                }
            });
        }
