extends layout

block content
    .container-fluid.mt-4
        .d-flex.justify-content-between.align-items-center.mb-4
            h2
                i.bi.bi-bell.me-2
                | Notificaciones

            if notificaciones && notificaciones.length
                form(
                    action="/usuario/notificaciones/marcar-todas-leidas"
                    method="POST"
                )
                    button.btn.btn-outline-success(type="submit")
                        i.bi.bi-check2-all.me-1
                        | Marcar todas como leídas

        if notificaciones && notificaciones.length
            .list-group.shadow-sm

                each notif in notificaciones

                    - const url = (notif.tipo === 'seguimiento' || !notif.idReferencia) ? null : `/usuario/publicaciones/${notif.idReferencia}`

                    .list-group-item.list-group-item-action(
                        class=notif.leida ? "" : "list-group-item-light fw-bold"
                        style="cursor: default;"
                    )
                        .d-flex.justify-content-between.align-items-center.gap-3

                            if url
                                a.d-flex.align-items-center.gap-3.text-decoration-none.text-dark.flex-grow-1(
                                    href=url
                                )
                                    if notif.origen
                                        if notif.origen.avatar
                                            img.rounded-circle(
                                                src=notif.origen.avatar
                                                width="45"
                                                height="45"
                                                style="object-fit: cover; flex-shrink:0"
                                            )
                                        else
                                            .rounded-circle.bg-success.text-white.d-flex.align-items-center.justify-content-center(
                                                style="width:45px;height:45px;flex-shrink:0"
                                            )
                                                = notif.origen.username[0].toUpperCase()
                                    .notification-content
                                        p.mb-1= notif.mensaje
                                        small.text-muted= new Date(notif.createdAt).toLocaleString("es-AR")
                                        if notif.tipo === 'comentario'
                                            span.badge.bg-secondary.ms-2 💬 Ver publicación
                                        else if notif.tipo === 'valoracion'
                                            span.badge.bg-secondary.ms-2 ⭐ Ver publicación
                                        else if notif.tipo === 'interes'
                                            span.badge.bg-secondary.ms-2 🖼 Ver publicación
                            else
                                .d-flex.align-items-center.gap-3.flex-grow-1

                                    if notif.origen
                                        if notif.origen.avatar
                                            img.rounded-circle(
                                                src=notif.origen.avatar
                                                width="45"
                                                height="45"
                                                style="object-fit: cover;"
                                            )
                                        else
                                            .rounded-circle.bg-success.text-white.d-flex.align-items-center.justify-content-center(
                                                style="width:45px;height:45px;flex-shrink:0"
                                            )
                                                = notif.origen.username[0].toUpperCase()

                                    .notification-content
                                        p.mb-1= notif.mensaje
                                        small.text-muted= new Date(notif.createdAt).toLocaleString("es-AR")

                            if !notif.leida
                                form(
                                    action=`/usuario/notificaciones/${notif.id}/leida`
                                    method="POST"
                                )
                                    button.btn.btn-sm.btn-outline-secondary(
                                        type="submit"
                                        title="Marcar como leída"
                                    )
                                        i.bi.bi-check2
                                        |  Leída

        else
            .card.shadow-sm
                .card-body.text-center.py-5
                    i.bi.bi-bell-slash.fs-1.text-muted
                    h4.mt-3 No tenés notificaciones
                    p.text-muted.mb-0
                        | Cuando alguien interactúe con vos, aparecerán acá.
