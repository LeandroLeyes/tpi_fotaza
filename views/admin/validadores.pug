extends layout

block content
    .container-fluid.mt-4

        .d-flex.justify-content-between.align-items-center.mb-4
                    h4.mb-0
                        i.bi.bi-shield-lock.me-2
                        | Gestión de Validadores
                    div
                        a.btn.btn-success.btn-sm.me-2(href="/admin/usuarios/crear")
                            i.bi.bi-plus-lg.me-1
                            | Nuevo Validador
                        a.btn.btn-outline-secondary.btn-sm(href="/admin/home")
                            i.bi.bi-arrow-left.me-1
                            | Volver

        .card.border-0.shadow-sm
            .card-body.p-0
                .table-responsive
                    table.table.table-hover.mb-0
                        thead.table-light
                            tr
                                th Validador
                                th Email
                                th Estado
                                th.text-end Acciones
                        tbody
                            if usuarios.length > 0
                                each u in usuarios
                                    tr(class= !u.activo ? 'table-danger' : '')
                                        td
                                            .d-flex.align-items-center.gap-2
                                                if u.avatar
                                                    img.rounded-circle(src=u.avatar width="32" height="32" style="object-fit:cover")
                                                else
                                                    .avatar-placeholder.rounded-circle(style="width:32px;height:32px;font-size:12px;display:flex;align-items:center;justify-content:center;background:#636B2F;color:white")= u.name[0].toUpperCase() + u.lastName[0].toUpperCase()
                                                span= u.username
                                        td.text-muted.small= u.email
                                        td
                                            if u.activo
                                                span.badge.bg-success Activo
                                            else
                                                span.badge.bg-danger Bloqueado
                                        td
                                            .d-flex.gap-1.justify-content-end                                              
                                                form(action=`/admin/validadores/${u.id}/eliminar` method="POST" onsubmit="return confirm('¿Estás seguro de eliminar este validador de forma permanente?');")
                                                    button.btn.btn-sm.btn-outline-danger(type="submit" title="Eliminar validador")
                                                        i.bi.bi-trash

                                                form(action=`/admin/validadores/${u.id}/toggle` method="POST")
                                                    button.btn.btn-sm(class= u.activo ? 'btn-outline-warning' : 'btn-outline-success' type="submit" title= u.activo ? 'Bloquear cuenta' : 'Activar cuenta')
                                                        i.bi(class= u.activo ? 'bi-person-slash' : 'bi-person-check')
                            else
                                tr
                                    td.text-center.py-4.text-muted(colspan="4") No hay validadores registrados actualmente en el sistema.