extends layout

block content

    .container-fluid.mt-4

        .d-flex.justify-content-between.align-items-center.mb-4

            h4.mb-0
                i.bi.bi-people.me-2
                | Gestión de usuarios

            a.btn.btn-outline-secondary.btn-sm(href="/admin/home")
                i.bi.bi-arrow-left.me-1
                | Volver

        .card.border-0.shadow-sm

            .card-body.p-0

                .table-responsive

                    table.table.table-hover.mb-0

                        thead.table-light

                            tr

                                th Usuario
                                th Email
                                th Rol
                                th Estado
                                th.text-end Acciones

                        tbody

                            each u in usuarios

                                tr(class= !u.activo ? 'table-danger' : '')

                                    td

                                        .d-flex.align-items-center.gap-2

                                            if u.avatar
                                                img.rounded-circle(
                                                    src=u.avatar
                                                    width="32"
                                                    height="32"
                                                    style="object-fit:cover"
                                                )
                                            else
                                                .avatar-placeholder.rounded-circle(
                                                    style="width:32px;height:32px;font-size:12px;display:flex;align-items:center;justify-content:center;background:#636B2F;color:white"
                                                )= u.name[0].toUpperCase() + u.lastName[0].toUpperCase()

                                            span= u.username

                                    td.text-muted.small= u.email

                                    td

                                        case u.rol
                                            when 'admin'
                                                span.badge.bg-danger Admin
                                            when 'validador'
                                                span.badge.bg-warning.text-dark Validador
                                            default
                                                span.badge.bg-secondary Usuario

                                    td

                                        if u.activo
                                            span.badge.bg-success Activo
                                        else
                                            span.badge.bg-danger Bloqueado

                                    td

                                        .d-flex.gap-1.justify-content-end

                                            if u.rol !== 'admin'

                                                if u.rol === 'validador'

                                                    form(
                                                        action=`/admin/usuarios/${u.id}/quitar-validador`
                                                        method="POST"
                                                    )
                                                        button.btn.btn-sm.btn-outline-warning(
                                                            type="submit"
                                                            title="Quitar validador"
                                                        )
                                                            i.bi.bi-shield-x

                                                else

                                                    form(
                                                        action=`/admin/usuarios/${u.id}/validador`
                                                        method="POST"
                                                    )
                                                        button.btn.btn-sm.btn-outline-success(
                                                            type="submit"
                                                            title="Hacer validador"
                                                        )
                                                            i.bi.bi-shield-check

                                                form(
                                                    action=`/admin/usuarios/${u.id}/toggle`
                                                    method="POST"
                                                )
                                                    button.btn.btn-sm(
                                                        type="submit"
                                                        class= u.activo ? 'btn-outline-danger' : 'btn-outline-success'
                                                        title= u.activo ? 'Bloquear cuenta' : 'Activar cuenta'
                                                    )
                                                        i.bi(class= u.activo ? 'bi-person-slash' : 'bi-person-check')
