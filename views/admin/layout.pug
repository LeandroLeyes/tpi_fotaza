doctype html
html(lang="es")

  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || "Fotaza — Admin"
    link(rel="icon", type="image/png", href="/images/fotaza-logo-1.png")
    link(rel="stylesheet", href="/bootstrap/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css")
    link(rel="stylesheet", href="/css/style.css")

  body

    .main-layout

      include sidebar

      .main-content
      
        header.topbar.d-flex.justify-content-between.align-items-center.px-4.py-3.bg-white.border-bottom
            .d-flex.align-items-center
                h5.mb-0.text-danger 
                    i.bi.bi-hdd-network.me-2
                    | Consola de Administración
            
            .d-flex.align-items-center.gap-3
                span.badge.bg-danger Sistema Global
                a.text-danger(href="/auth/logout" title="Cerrar sesión")
                    i.bi.bi-box-arrow-right.fs-5

        main.content-area.p-4
          
          block content

          include ../partials/footer

    script(src="/bootstrap/js/bootstrap.bundle.min.js")